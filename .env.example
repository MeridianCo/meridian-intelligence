GEMINI_API_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=

# Event discovery provider keys (server-side only)
SERPAPI_API_KEY=
EVENTBRITE_PRIVATE_TOKEN=
TICKETMASTER_API_KEY=

# Event discovery provider flags (dev defaults are enabled when unset)
EVENT_DISCOVERY_ENABLE_SERPAPI=true
EVENT_DISCOVERY_ENABLE_EVENTBRITE=false
EVENT_DISCOVERY_ENABLE_TICKETMASTER=true

# Optional: limit Eventbrite provider to these organization IDs (comma-separated).
# If unset, the provider will use `/v3/users/me/organizations/` for the token owner.
EVENTBRITE_ORGANIZATION_IDS=
