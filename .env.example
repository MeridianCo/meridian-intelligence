# Environment variables for ai-profile-intelligience
# Copy this file to .env and fill in your values.

# --- Optional: Proxycurl API key for LinkedIn enrichment ---
# Get one at https://nubela.co/proxycurl
# Leave empty to run without LinkedIn enrichment.
PROXYCURL_API_KEY=

# --- Optional: Clearbit API key ---
# Get one at https://clearbit.com
CLEARBIT_API_KEY=

# --- Service tuning ---
HTTP_TIMEOUT=15.0
HTTP_MAX_RETRIES=3
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=256
DEBUG=false
